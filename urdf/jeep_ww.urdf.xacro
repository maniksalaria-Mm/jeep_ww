<?xml version="1.0"?>
<!--
  jeep_ww : full-size 4-door off-road SUV (real-world size and weight)
    wheelbase 3.022 m | track 1.70 m | length ~5.0 m | body width 2.01 m | height 1.97 m
    tyres 255/60 R20 (radius 0.407 m) | mass ~2.34 t | 12.84 m turning circle
    car-like (Ackermann) steering, rear-wheel drive in simulation

  Frames
    base_footprint : on the ground, under the centre of the REAR axle (odometry frame)
    base_link      : centre of the rear axle (wheel-centre height)
    lidar_link     : 2D lidar on the roof rack, ~2.10 m above the ground (mapping / localisation)
    front_lidar_link : 2D lidar in the front bumper, 0.55 m above the ground, 180 deg
                       (sees people and cars, which are below the roof lidar)
-->
<robot name="jeep_ww" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ===================== Parameters ===================== -->
  <xacro:property name="mesh_dir"      value="file://$(find jeep_ww)/meshes"/>
  <xacro:property name="wheel_radius"  value="0.407"/>
  <xacro:property name="wheel_width"   value="0.255"/>
  <xacro:property name="wheel_mass"    value="35.0"/>
  <xacro:property name="wheelbase"     value="3.022"/>
  <xacro:property name="track"         value="1.70"/>
  <xacro:property name="body_mass"     value="2200.0"/>
  <xacro:property name="max_steer"     value="0.52"/>   <!-- ~30 deg => 12.84 m turning circle -->
  <xacro:property name="lidar_height"  value="2.10"/>   <!-- above ground -->

  <!-- ===================== Colours ===================== -->
  <material name="paint">     <color rgba="0.36 0.40 0.18 1.0"/></material>  <!-- olive green -->
  <material name="glass">     <color rgba="0.10 0.13 0.18 1.0"/></material>
  <material name="trim">      <color rgba="0.08 0.08 0.08 1.0"/></material>
  <material name="chrome">    <color rgba="0.65 0.65 0.68 1.0"/></material>
  <material name="headlight"> <color rgba="0.98 0.98 0.90 1.0"/></material>
  <material name="taillight"> <color rgba="0.85 0.06 0.06 1.0"/></material>
  <material name="tyre">      <color rgba="0.07 0.07 0.07 1.0"/></material>
  <material name="rim">       <color rgba="0.42 0.42 0.45 1.0"/></material>

  <xacro:macro name="mesh_visual" params="name file material">
    <visual name="${name}">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="${mesh_dir}/${file}"/></geometry>
      <material name="${material}"/>
    </visual>
  </xacro:macro>

  <!-- ===================== Body ===================== -->
  <link name="base_footprint"/>

  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 ${wheel_radius}" rpy="0 0 0"/>
  </joint>

  <link name="base_link">
    <inertial>
      <!-- centre of mass between the axles, low (heavy frame / engine) -->
      <origin xyz="1.50 0 0.15" rpy="0 0 0"/>
      <mass value="${body_mass}"/>
      <inertia ixx="1021" iyy="4583" izz="4886" ixy="0" ixz="0" iyz="0"/>
    </inertial>

    <xacro:mesh_visual name="body"        file="suv_body.stl"        material="paint"/>
    <xacro:mesh_visual name="glass"       file="suv_glass.stl"       material="glass"/>
    <xacro:mesh_visual name="trim"        file="suv_trim.stl"        material="trim"/>
    <xacro:mesh_visual name="grille"      file="suv_grille.stl"      material="chrome"/>
    <xacro:mesh_visual name="headlights"  file="suv_headlights.stl"  material="headlight"/>
    <xacro:mesh_visual name="taillights"  file="suv_taillights.stl"  material="taillight"/>
    <xacro:mesh_visual name="spare_tire"  file="suv_spare_tire.stl"  material="tyre"/>
    <xacro:mesh_visual name="spare_rim"   file="suv_spare_rim.stl"   material="rim"/>

    <!-- Simple boxes for collision: fast and stable -->
    <collision name="lower_body">
      <origin xyz="1.55 0 0.443" rpy="0 0 0"/>
      <geometry><box size="4.80 1.88 0.66"/></geometry>
    </collision>
    <collision name="cabin">
      <origin xyz="0.66 0 1.143" rpy="0 0 0"/>
      <geometry><box size="2.88 1.74 0.74"/></geometry>
    </collision>
  </link>

  <gazebo reference="base_link">
    <mu1>0.5</mu1>
    <mu2>0.5</mu2>
  </gazebo>

  <!-- ===================== Wheels ===================== -->
  <!-- side: 1 = left, -1 = right. Right-hand visuals are turned 180 deg so the rim faces out. -->
  <xacro:macro name="wheel_link" params="name side">
    <link name="${name}">
      <inertial>
        <mass value="${wheel_mass}"/>
        <inertia ixx="1.64" iyy="2.90" izz="1.64" ixy="0" ixz="0" iyz="0"/>
      </inertial>
      <visual name="tyre">
        <origin xyz="0 0 0" rpy="0 0 ${0 if side == 1 else pi}"/>
        <geometry><mesh filename="${mesh_dir}/suv_tire.stl"/></geometry>
        <material name="tyre"/>
      </visual>
      <visual name="rim">
        <origin xyz="0 0 0" rpy="0 0 ${0 if side == 1 else pi}"/>
        <geometry><mesh filename="${mesh_dir}/suv_rim.stl"/></geometry>
        <material name="rim"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
      </collision>
    </link>
    <gazebo reference="${name}">
      <mu1>1.0</mu1>
      <mu2>1.0</mu2>
      <kp>1e7</kp>
      <kd>1e3</kd>
    </gazebo>
  </xacro:macro>

  <!-- Rear wheels: driven -->
  <xacro:macro name="rear_wheel" params="prefix side">
    <xacro:wheel_link name="${prefix}_wheel" side="${side}"/>
    <joint name="${prefix}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${prefix}_wheel"/>
      <origin xyz="0 ${side * track / 2} 0" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
    </joint>
  </xacro:macro>

  <!-- Front wheels: steered (knuckle turns about z), free rolling -->
  <xacro:macro name="front_wheel" params="prefix side">
    <link name="${prefix}_steer">
      <inertial>
        <mass value="5.0"/>
        <inertia ixx="0.05" iyy="0.05" izz="0.05" ixy="0" ixz="0" iyz="0"/>
      </inertial>
    </link>
    <joint name="${prefix}_steer_joint" type="revolute">
      <parent link="base_link"/>
      <child link="${prefix}_steer"/>
      <origin xyz="${wheelbase} ${side * track / 2} 0" rpy="0 0 0"/>
      <axis xyz="0 0 1"/>
      <limit lower="${-max_steer}" upper="${max_steer}" effort="5000" velocity="2.0"/>
    </joint>
    <xacro:wheel_link name="${prefix}_wheel" side="${side}"/>
    <joint name="${prefix}_wheel_joint" type="continuous">
      <parent link="${prefix}_steer"/>
      <child link="${prefix}_wheel"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
    </joint>
  </xacro:macro>

  <xacro:rear_wheel  prefix="rear_left"   side="1"/>
  <xacro:rear_wheel  prefix="rear_right"  side="-1"/>
  <xacro:front_wheel prefix="front_left"  side="1"/>
  <xacro:front_wheel prefix="front_right" side="-1"/>

  <!-- ===================== Roof lidar ===================== -->
  <link name="lidar_link">
    <inertial>
      <mass value="0.8"/>
      <inertia ixx="0.001" iyy="0.001" izz="0.001" ixy="0" ixz="0" iyz="0"/>
    </inertial>
    <visual name="lidar_base">
      <origin xyz="0 0 -0.065" rpy="0 0 0"/>
      <geometry><box size="0.22 0.22 0.02"/></geometry>
      <material name="trim"/>
    </visual>
    <visual name="lidar_head">
      <origin xyz="0 0 -0.02" rpy="0 0 0"/>
      <geometry><cylinder radius="0.06" length="0.07"/></geometry>
      <material name="trim"/>
    </visual>
  </link>

  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_link"/>
    <origin xyz="0.55 0 ${lidar_height - wheel_radius}" rpy="0 0 0"/>
  </joint>

  <gazebo reference="lidar_link">
    <sensor name="roof_lidar" type="gpu_lidar">
      <update_rate>10</update_rate>
      <topic>scan</topic>
      <gz_frame_id>lidar_link</gz_frame_id>
      <always_on>true</always_on>
      <visualize>true</visualize>
      <lidar>
        <scan>
          <horizontal>
            <samples>720</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159</min_angle>
            <max_angle>3.14159</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.40</min>
          <max>30.0</max>
          <resolution>0.01</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </lidar>
    </sensor>
  </gazebo>

  <!-- ===================== Front bumper lidar (low obstacles: people, cars) ===================== -->
  <link name="front_lidar_link">
    <inertial>
      <mass value="0.5"/>
      <inertia ixx="0.001" iyy="0.001" izz="0.001" ixy="0" ixz="0" iyz="0"/>
    </inertial>
    <visual name="front_lidar">
      <origin xyz="-0.02 0 0" rpy="0 0 0"/>
      <geometry><box size="0.08 0.16 0.07"/></geometry>
      <material name="trim"/>
    </visual>
  </link>

  <joint name="front_lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="front_lidar_link"/>
    <origin xyz="4.02 0 ${0.55 - wheel_radius}" rpy="0 0 0"/>
  </joint>

  <gazebo reference="front_lidar_link">
    <sensor name="front_lidar" type="gpu_lidar">
      <update_rate>10</update_rate>
      <topic>front_scan</topic>
      <gz_frame_id>front_lidar_link</gz_frame_id>
      <always_on>true</always_on>
      <visualize>false</visualize>
      <lidar>
        <scan>
          <horizontal>
            <samples>361</samples>
            <resolution>1</resolution>
            <min_angle>-1.5708</min_angle>
            <max_angle>1.5708</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>1.0</min>   <!-- closer hits are the SUV's own bumper -->
          <max>20.0</max>
          <resolution>0.01</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </lidar>
    </sensor>
  </gazebo>

  <!-- ===================== Gazebo systems ===================== -->
  <gazebo>
    <!-- Car-like steering: listens on /cmd_vel (linear.x = speed, angular.z = yaw rate),
         publishes /odom and the odom -> base_footprint TF -->
    <plugin filename="gz-sim-ackermann-steering-system" name="gz::sim::systems::AckermannSteering">
      <left_joint>rear_left_wheel_joint</left_joint>
      <right_joint>rear_right_wheel_joint</right_joint>
      <left_steering_joint>front_left_steer_joint</left_steering_joint>
      <right_steering_joint>front_right_steer_joint</right_steering_joint>
      <kingpin_width>${track}</kingpin_width>
      <steering_limit>${max_steer}</steering_limit>
      <wheel_base>${wheelbase}</wheel_base>
      <wheel_separation>${track}</wheel_separation>
      <wheel_radius>${wheel_radius}</wheel_radius>
      <min_velocity>-4.0</min_velocity>
      <max_velocity>8.0</max_velocity>
      <min_acceleration>-3.0</min_acceleration>
      <max_acceleration>1.5</max_acceleration>
      <topic>cmd_vel</topic>
      <odom_topic>odom</odom_topic>
      <tf_topic>tf</tf_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_footprint</child_frame_id>
      <odom_publish_frequency>30</odom_publish_frequency>
      <steer_p_gain>4.0</steer_p_gain>
    </plugin>

    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
      <topic>joint_states</topic>
    </plugin>
  </gazebo>

</robot>
