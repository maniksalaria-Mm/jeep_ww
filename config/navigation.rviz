Panels:
- Class: rviz_common/Displays
  Name: Displays
  Help Height: 0
  Tree Height: 500
- Class: rviz_common/Tool Properties
  Name: Tool Properties
- Class: rviz_common/Views
  Name: Views
Visualization Manager:
  Class: ''
  Displays:
  - Class: rviz_default_plugins/Grid
    Name: Grid
    Enabled: true
    Cell Size: 5
    Plane Cell Count: 40
    Color: 160; 160; 164
    Reference Frame: <Fixed Frame>
    Value: true
  - Class: rviz_default_plugins/Map
    Name: Map
    Enabled: true
    Alpha: 0.8
    Color Scheme: map
    Draw Behind: true
    Topic:
      Value: /map
      Depth: 1
      Durability Policy: Transient Local
      History Policy: Keep Last
      Reliability Policy: Reliable
    Update Topic:
      Value: /map_updates
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Reliable
    Use Timestamp: false
    Value: true
  - Class: rviz_default_plugins/Map
    Name: Global costmap
    Enabled: true
    Alpha: 0.35
    Color Scheme: costmap
    Draw Behind: false
    Topic:
      Value: /global_costmap/costmap
      Depth: 1
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Reliable
    Update Topic:
      Value: /global_costmap/costmap_updates
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Reliable
    Use Timestamp: false
    Value: true
  - Class: rviz_default_plugins/Map
    Name: Local costmap
    Enabled: true
    Alpha: 0.5
    Color Scheme: costmap
    Draw Behind: false
    Topic:
      Value: /local_costmap/costmap
      Depth: 1
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Reliable
    Update Topic:
      Value: /local_costmap/costmap_updates
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Reliable
    Use Timestamp: false
    Value: true
  - Class: rviz_default_plugins/Path
    Name: Global plan
    Enabled: true
    Color: 25; 255; 0
    Line Style: Billboards
    Line Width: 0.25
    Alpha: 1
    Topic:
      Value: /plan
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Reliable
    Value: true
  - Class: rviz_default_plugins/Path
    Name: Local plan
    Enabled: true
    Color: 0; 160; 255
    Line Style: Billboards
    Line Width: 0.25
    Alpha: 1
    Topic:
      Value: /local_plan
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Reliable
    Value: true
  - Class: rviz_default_plugins/Polygon
    Name: Footprint
    Enabled: true
    Color: 255; 200; 0
    Alpha: 1
    Topic:
      Value: /local_costmap/published_footprint
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Reliable
    Value: true
  - Class: rviz_default_plugins/RobotModel
    Name: SUV
    Enabled: true
    Description Source: Topic
    Description Topic:
      Value: /robot_description
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Reliable
    Visual Enabled: true
    Collision Enabled: false
    Alpha: 1
    Value: true
  - Class: rviz_default_plugins/LaserScan
    Name: Lidar
    Enabled: true
    Size (m): 0.08
    Style: Flat Squares
    Color Transformer: FlatColor
    Color: 255; 50; 50
    Topic:
      Value: /scan
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Best Effort
    Value: true
  - Class: rviz_default_plugins/LaserScan
    Name: Front lidar
    Enabled: true
    Size (m): 0.08
    Style: Flat Squares
    Color Transformer: FlatColor
    Color: 255; 220; 0
    Topic:
      Value: /front_scan
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Best Effort
    Value: true
  - Class: rviz_default_plugins/TF
    Name: TF
    Enabled: false
    Show Names: false
    Marker Scale: 2
    Value: false
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
  - Class: rviz_default_plugins/Interact
    Hide Inactive Objects: true
  - Class: rviz_default_plugins/MoveCamera
  - Class: rviz_default_plugins/Select
  - Class: rviz_default_plugins/Measure
    Line color: 128; 128; 0
  - Class: rviz_default_plugins/SetInitialPose
    Topic:
      Value: /initialpose
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Reliable
    Covariance x: 0.25
    Covariance y: 0.25
    Covariance yaw: 0.068
  - Class: rviz_default_plugins/SetGoal
    Topic:
      Value: /goal_pose
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Reliable
  - Class: rviz_default_plugins/PublishPoint
    Single click: true
    Topic:
      Value: /clicked_point
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Reliable
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Name: Current View
      Scale: 5.5
      X: 30
      Y: 57
      Angle: 0
      Target Frame: <Fixed Frame>
      Near Clip Distance: 0.01
      Value: TopDownOrtho (rviz_default_plugins)
    Saved: null
Window Geometry:
  Height: 900
  Width: 1500
  Hide Left Dock: false
  Hide Right Dock: true
  Displays:
    collapsed: false
  Views:
    collapsed: true
  Tool Properties:
    collapsed: true
